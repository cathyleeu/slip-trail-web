# Copy to .env.local and replace placeholders. Never commit real credentials.
# Supabase Dashboard > Project Settings > API: use the SAME project for both.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only Groq credential; never use a NEXT_PUBLIC_ prefix.
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Server-only FULL POST endpoint and service key; never use NEXT_PUBLIC_ prefixes.
# Rollout prerequisite: OCR service must validate X-API-Key against OCR_API_KEY.
# The current Python service does not implement this contract yet (#38).
OCR_API_URL=http://localhost:8000/ocr
OCR_API_KEY=YOUR_OCR_SERVICE_KEY

# Match the browser origin and Supabase Auth redirect allowlist.
# pnpm dev uses HTTPS; use an HTTPS OCR endpoint in production.
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# Optional, server-only: lib/supabase/admin.ts has no current callers.
# Not required by the active receipt flow; do not provision elevated keys just to run it.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
