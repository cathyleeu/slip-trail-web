# Copy to .env.local and replace placeholders. Never commit real credentials.
# Supabase Dashboard > Project Settings > API: use the SAME project for both.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only Groq credential; never use a NEXT_PUBLIC_ prefix.
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Current implementation: browser-accessible FULL POST endpoint, including /ocr.
# The OCR service must allow the web origin through CORS. Never put a secret here.
NEXT_PUBLIC_OCR_API_URL=http://localhost:8000/ocr

# Match the browser origin and Supabase Auth redirect allowlist.
# pnpm dev uses HTTPS; a production HTTPS site also needs an HTTPS OCR endpoint.
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# Optional, server-only: lib/supabase/admin.ts has no current callers.
# Not required by the active receipt flow; do not provision elevated keys just to run it.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# OCR_API_URL / OCR_API_KEY are future server-side settings tracked by #38;
# current code does not consume them.
